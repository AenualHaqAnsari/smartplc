                height: measurement.height?.toString() ?? null,
                chest: measurement.chest?.toString() ?? null,
                waist: measurement.waist?.toString() ?? null,
                hip: measurement.hip?.toString() ?? null,
                shoulder: measurement.shoulder?.toString() ?? null,
                armLength: measurement.armLength?.toString() ?? null,
                bicep: measurement.bicep?.toString() ?? null,
                wrist: measurement.wrist?.toString() ?? null,
                thigh: measurement.thigh?.toString() ?? null,
                knee: measurement.knee?.toString() ?? null,
                calf: measurement.calf?.toString() ?? null,
                ankle: measurement.ankle?.toString() ?? null,
                neck: measurement.neck?.toString() ?? null,
                head: measurement.head?.toString() ?? null,
                unit: measurement.unit,
                notes: measurement.notes,
              }))}
            />

          </div>

        </section>


        {/* FULFILLMENT */}
        <section className="mt-7">

          <div className="mb-3">
            <p className="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#b49458]">
              Fulfillment
            </p>
          </div>

          <div className="border border-[#332d24] bg-[#12100d] p-5">
            <ShipmentControl
              orderNumber={order!.orderNumber}
            />
          </div>

        </section>


        {/* ORDER ITEMS */}
        <section className="mt-7 overflow-hidden border border-[#332d24] bg-[#12100d]">

          <div className="flex items-end justify-between border-b border-[#29251f] px-5 py-4">

            <div>
              <p className="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#b49458]">
                Products
              </p>

              <h2 className="mt-1 font-serif text-2xl font-bold">
                ORDER ITEMS
              </h2>
            </div>

            <span className="text-xs text-[#625c53]">
              {order!.items.reduce(
                (total, item) => total + item.quantity,
                0
              )} items
            </span>

          </div>


          <div className="divide-y divide-[#29251f]">

            {order!.items.map((item) => (

              <div
                key={item.id}
                className="px-5 py-5"
              >

                <div className="grid gap-5 lg:grid-cols-[1fr_auto_auto] lg:items-start">

                  {/* PRODUCT */}
                  <div>

                    <h3 className="text-base font-semibold text-[#eee8dc]">
                      {item.productName}
                    </h3>

                    {item.variant && (
                      <div className="mt-3 grid gap-x-8 gap-y-1 text-xs text-[#999184] sm:grid-cols-2 lg:grid-cols-4">

                        <p>
                          <span className="text-[#625c53]">
                            Variant:
                          </span>{" "}
                          <span className="text-[#c7a65e]">
                            {item.variant.name}
                          </span>
                        </p>

                        {item.variant.gauge && (
                          <p>
                            <span className="text-[#625c53]">
                              Gauge:
                            </span>{" "}
                            {item.variant.gauge}
                          </p>
                        )}

                        {item.variant.size && (
                          <p>
                            <span className="text-[#625c53]">
                              Size:
                            </span>{" "}
                            {item.variant.size}
                          </p>
                        )}

                        {item.variant.finish && (
                          <p>
                            <span className="text-[#625c53]">
                              Finish:
                            </span>{" "}
                            {item.variant.finish}
                          </p>
                        )}

                      </div>
                    )}

                    {item.customSize && (
                      <span className="mt-3 inline-block border border-[#6f5b35] bg-[#1a160e] px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.15em] text-[#c7a65e]">
                        Custom Size
                      </span>
                    )}

                  </div>


                  {/* QUANTITY / PRICE */}
                  <div className="grid grid-cols-2 gap-x-8 gap-y-2 text-xs lg:min-w-[150px]">

                    <span className="text-[#625c53]">
                      Quantity
                    </span>

                    <span className="text-right text-[#eee8dc]">
                      {item.quantity}
                    </span>

                    <span className="text-[#625c53]">
                      Unit Price
                    </span>

                    <span className="text-right text-[#999184]">
                      ${Number(item.unitPrice).toFixed(2)}
                    </span>

                  </div>


                  {/* TOTAL */}
                  <div className="text-left lg:min-w-[130px] lg:text-right">

                    <p className="text-[9px] uppercase tracking-[0.15em] text-[#625c53]">
                      Item Total
                    </p>

                    <p className="mt-1 text-lg font-bold text-[#c7a65e]">
                      ${Number(item.totalPrice).toFixed(2)}
                    </p>

                  </div>

                </div>

              </div>

            ))}

          </div>

        </section>


        {/* CUSTOM MEASUREMENTS */}
        {measurements.length > 0 && (

          <section className="mt-7 overflow-hidden border border-[#332d24] bg-[#12100d]">

            <div className="border-b border-[#29251f] px-5 py-4">

              <p className="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#b49458]">
                Custom Armor
              </p>

              <h2 className="mt-1 font-serif text-2xl font-bold">
                MEASUREMENTS
              </h2>

            </div>


            <div className="divide-y divide-[#29251f]">

              {measurements.map((measurement) => (

                <div
                  key={measurement.id}
                  className="p-5"
                >

                  <div className="flex items-center justify-between border-b border-[#29251f] pb-3">

                    <div>
                      <p className="text-sm font-semibold text-[#eee8dc]">
                        {measurement.itemName || "Custom Item"}
                      </p>

                      <p className="mt-1 text-[9px] uppercase tracking-[0.15em] text-[#625c53]">
                        Custom Measurements
                      </p>
                    </div>

                    <span className="text-[9px] uppercase tracking-[0.15em] text-[#625c53]">
                      {measurement.unit}
                    </span>

                  </div>


                  <div className="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-7">

                    <Measurement
                      label="Height"
                      value={measurement.height}
                    />

                    <Measurement
                      label="Chest"
                      value={measurement.chest}
                    />

                    <Measurement
                      label="Waist"
                      value={measurement.waist}
                    />

                    <Measurement
                      label="Hip"
                      value={measurement.hip}
                    />

                    <Measurement
                      label="Shoulder"
                      value={measurement.shoulder}
                    />

                    <Measurement
                      label="Arm Length"
                      value={measurement.armLength}
                    />

                    <Measurement
                      label="Bicep"
                      value={measurement.bicep}
                    />

                    <Measurement
                      label="Wrist"
                      value={measurement.wrist}
                    />

                    <Measurement
                      label="Thigh"
                      value={measurement.thigh}
                    />

                    <Measurement
                      label="Knee"
                      value={measurement.knee}
                    />

                    <Measurement
                      label="Calf"
                      value={measurement.calf}
                    />

                    <Measurement
                      label="Ankle"
                      value={measurement.ankle}
                    />

                    <Measurement
                      label="Neck"
                      value={measurement.neck}
                    />

                    <Measurement
                      label="Head"
                      value={measurement.head}
                    />

                  </div>

                  {measurement.notes && (
                    <div className="mt-4 border border-[#29251f] bg-[#0f0e0c] p-3">

                      <p className="text-[9px] uppercase tracking-[0.15em] text-[#625c53]">
                        Notes
                      </p>

                      <p className="mt-1 text-xs leading-5 text-[#999184]">
                        {measurement.notes}
                      </p>

                    </div>
                  )}

                </div>

              ))}

            </div>

          </section>

        )}


        {/* FINANCIAL SUMMARY */}
        <section className="mt-7 flex justify-end">

          <div className="w-full max-w-md overflow-hidden border border-[#332d24] bg-[#12100d]">

            <div className="border-b border-[#29251f] px-5 py-4">

              <p className="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#b49458]">
                Financial Summary
              </p>

              <h2 className="mt-1 font-serif text-2xl font-bold">
                ORDER TOTAL
              </h2>

            </div>


            <div className="space-y-3 p-5 text-sm">

              <div className="flex justify-between text-[#999184]">
                <span>Subtotal</span>
                <span>
                  ${Number(order!.subtotal).toFixed(2)}
                </span>
              </div>

              <div className="flex justify-between text-[#999184]">

                <span>
                  Discount (
                  {Number(order!.subtotal) > 0
                    ? (
                        (Number(order!.discount) /
                          Number(order!.subtotal)) *
                        100
                      ).toFixed(0)
                    : "0"}
                  %)
                </span>

                <span className="text-[#8fbf7f]">
                  -${Number(order!.discount).toFixed(2)}
                </span>

              </div>

              <div className="flex justify-between text-[#999184]">
                <span>Shipping</span>
                <span>
                  ${Number(order!.shippingCost).toFixed(2)}
                </span>
              </div>

              <div className="flex justify-between text-[#999184]">
                <span>Tax</span>
                <span>
                  ${Number(order!.tax).toFixed(2)}
                </span>
              </div>

              <div className="my-4 h-px bg-[#332d24]" />

              <div className="flex items-center justify-between">

                <span className="font-serif text-lg font-bold">
                  Total
                </span>

                <span className="text-2xl font-bold text-[#c7a65e]">
                  ${Number(order!.total).toFixed(2)}
                </span>

              </div>

            </div>

          </div>

        </section>

      </section>
    </main>
  )
}

function Measurement({
  label,
  value,
}: {
  label: string;
  value: unknown;
}) {
  if (value === null || value === undefined) {
    return null;
  }

  return (
    <div className="border border-[#29251f] bg-[#0f0e0c] p-3">
      <p className="text-[9px] uppercase tracking-[0.15em] text-[#625c53]">{label}</p>
      <p className="mt-1 text-sm font-semibold text-[#eee8dc]">{String(value)}</p>
    </div>
  );
}

}

