@import "tailwindcss" source(none);
:root {
  --background: #f7f3ea;
  --foreground: #242321;
  --heritage-ivory: #f7f3ea;
  --heritage-white: #fffdf8;
  --heritage-stone: #ded6c8;
  --heritage-charcoal: #242321;
  --heritage-muted: #6b665e;
  --heritage-brass: #a78345;
  --heritage-brass-dark: #8f6d39;
}


html {
  background: var(--background);
}

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

::selection {
  background: var(--heritage-brass);
  color: #ffffff;
}







